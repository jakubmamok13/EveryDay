{
  "name": "everyday",
  "private": true,
  "version": "0.1.0",
  "description": "EveryDay: a free cycling coach that runs on your phone",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "library"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace apps/web",
    "dev": "npm run dev --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p library && tsc -p packages/engine && tsc -p packages/core && tsc -p apps/web"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
